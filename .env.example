# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
LOG_LEVEL=INFO

# ── Financial Data APIs ───────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
POLYGON_API_KEY=your_polygon_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://alphasignal:password@localhost:5432/alphasignal

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_TO_NUMBER=+0987654321

# ── SendGrid Email ────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=you@yourdomain.com

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#trading-alerts

# ── ML Settings ───────────────────────────────────────────────────────────────
SIGNAL_CONFIDENCE_THRESHOLD=0.65
MODEL_SAVE_PATH=./models/saved

# ── Ports ─────────────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
